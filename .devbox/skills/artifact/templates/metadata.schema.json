{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artifact Metadata",
  "type": "object",
  "required": [
    "ticket_id",
    "ticket_type",
    "title",
    "status",
    "target_alias",
    "target_type",
    "target_path",
    "created_at"
  ],
  "properties": {
    "ticket_id": {
      "type": "string",
      "pattern": "^(CR|TASK)-[A-Z0-9-]+$"
    },
    "ticket_type": {
      "type": "string",
      "enum": ["CR", "TASK", "BUG", "FEATURE", "REFACTOR"]
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "failed", "cancelled"]
    },
    "target_alias": {
      "type": "string"
    },
    "target_type": {
      "type": "string"
    },
    "target_path": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "problem_statement": {
      "type": "string"
    },
    "solution_overview": {
      "type": "string"
    },
    "implementation_approach": {
      "type": "string"
    },
    "implementation_patterns": {
      "type": "string"
    },
    "implementation_decisions": {
      "type": "string"
    },
    "component_details": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "type"],
        "properties": {
          "file": { "type": "string" },
          "type": { "type": "string", "enum": ["new", "modified", "deleted", "config"] },
          "lines_added": { "type": "integer", "minimum": 0 },
          "lines_removed": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" }
        }
      }
    },
    "unified_diff": {
      "type": "string"
    },
    "gate_status": {
      "type": "string",
      "enum": ["passed", "failed", "skipped", "pending"]
    },
    "gate_output": {
      "type": "string"
    },
    "test_summary": {
      "type": "object",
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "test_output": {
      "type": "string"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed", "pending"] }
        }
      }
    },
    "spec_url": {
      "type": "string",
      "format": "uri"
    },
    "task_url": {
      "type": "string",
      "format": "uri"
    },
    "pr_url": {
      "type": "string",
      "format": "uri"
    },
    "commits_url": {
      "type": "string",
      "format": "uri"
    }
  }
}