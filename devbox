def init_project(template: str, alias: str, path: Optional[str], config: Dict[str, Any]) -> None:
    templates_dir = Path(".devbox/templates")
    template_path = templates_dir / template
    
    if not template_path.exists():
        print(f"[ERROR] Template '{template}' not found in {templates_dir}")
        print("Available templates:")
        for t in templates_dir.iterdir():
            if t.is_dir():
                print(f"  • {t.name}")
        sys.exit(1)
    
    if not path:
        path = f"../{alias}"
    
    abs_path = os.path.abspath(path)
    if os.path.exists(abs_path):
        print(f"[ERROR] Target path already exists: {abs_path}")
        sys.exit(1)
    
    print(f"[INIT] Initializing project '{alias}' from template '{template}' at {abs_path}")
    
    shutil.copytree(template_path, abs_path)
    
    if "projects" not in config:
        config["projects"] = {}
    
    detected_type = template.split("/")[0] if "/" in template else template
    
    config["projects"][alias] = {
        "path": path,
        "type": detected_type,
        "description": f"Project initialized from {template} template",
        "skills": config.get("tech_stacks", {}).get(detected_type, {}).get("default_skills", [])
    }
    
    save_config(config)
    print(f"[OK] Project '{alias}' created and registered")
    print(f"   Run: ./devbox gate {alias}  (after installing dependencies)")

def main() -> None:
    parser = argparse.ArgumentParser(description="Devbox Operator Control Plane")
    subparsers = parser.add_subparsers(dest="subcommand", help="Available commands")

    # list
    subparsers.add_parser("list", help="List all registered projects")

    # gate
    gate_parser = subparsers.add_parser("gate", help="Run verification gate for a project")
    gate_parser.add_argument("alias", help="Project alias")

    # task
    task_parser = subparsers.add_parser("task", help="Create a task package in .agent-inbox")
    task_parser.add_argument("alias", help="Target project alias")
    task_parser.add_argument("prompt", help="Task prompt description")

    # artifact
    artifact_parser = subparsers.add_parser("artifact", help="Manage documentation artifacts")
    artifact_sub = artifact_parser.add_subparsers(dest="artifact_action")
    
    # artifact create
    create_parser = artifact_sub.add_parser("create", help="Create a new artifact")
    create_parser.add_argument("alias", help="Project alias")
    create_parser.add_argument("ticket_id", help="Ticket ID (e.g., CR-101, TASK-20240115)")
    create_parser.add_argument("ticket_type", help="Ticket type", choices=["CR", "TASK", "BUG", "FEATURE", "REFACTOR"])
    create_parser.add_argument("title", help="Artifact title")
    create_parser.add_argument("prompt", help="Problem statement / prompt")
    
    # artifact update
    update_parser = artifact_sub.add_parser("update", help="Update artifact metadata")
    update_parser.add_argument("ticket_id", help="Ticket ID")
    update_parser.add_argument("--status", help="Status", choices=["pending", "in_progress", "completed", "failed", "cancelled"])
    update_parser.add_argument("--title", help="Title")
    update_parser.add_argument("--problem", help="Problem statement")
    update_parser.add_argument("--solution", help="Solution overview")
    update_parser.add_argument("--approach", help="Implementation approach")
    update_parser.add_argument("--patterns", help="Patterns used")
    update_parser.add_argument("--decisions", help="Key decisions")
    update_parser.add_argument("--components", help="Component details")
    
    # artifact finalize
    finalize_parser = artifact_sub.add_parser("finalize", help="Finalize artifact with gate/test results")
    finalize_parser.add_argument("ticket_id", help="Ticket ID")
    finalize_parser.add_argument("--gate-passed", action="store_true", help="Gate passed")
    finalize_parser.add_argument("--gate-output", help="Gate output text")
    finalize_parser.add_argument("--tests-passed", type=int, default=0, help="Tests passed")
    finalize_parser.add_argument("--tests-failed", type=int, default=0, help="Tests failed")
    finalize_parser.add_argument("--tests-skipped", type=int, default=0, help="Tests skipped")
    finalize_parser.add_argument("--test-output", help="Test output text")
    
    # artifact list
    artifact_sub.add_parser("list", help="List all artifacts")
    
    # artifact open
    open_parser = artifact_sub.add_parser("open", help="Open artifact in browser")
    open_parser.add_argument("ticket_id", help="Ticket ID")

    # detect
    detect_parser = subparsers.add_parser("detect", help="Detect tech stack for a path")
    detect_parser.add_argument("path", help="Path to project directory")

    # validate
    subparsers.add_parser("validate", help="Validate devbox-config.yaml")

    # tech-stacks
    subparsers.add_parser("tech-stacks", help="List registered tech stacks")

    # skills
    subparsers.add_parser("skills", help="List available skills")

    # init
    init_parser = subparsers.add_parser("init", help="Initialize a new project from template")
    init_parser.add_argument("template", help="Template name (e.g., node/nextjs, python/fastapi)")
    init_parser.add_argument("alias", help="Project alias to register")
    init_parser.add_argument("path", nargs="?", help="Target path (default: ../<alias>)")

    args = parser.parse_args()
    config = load_config()

    if args.subcommand == "list":
        list_projects(config)
    elif args.subcommand == "gate":
        run_gate(args.alias, config)
    elif args.subcommand == "task":
        create_task(args.alias, args.prompt, config)
    elif args.subcommand == "artifact":
        if args.artifact_action == "create":
            create_artifact(args.alias, args.ticket_id, args.ticket_type, args.title, args.prompt, config)
        elif args.artifact_action == "update":
            updates = {}
            if args.status: updates["status"] = args.status
            if args.title: updates["title"] = args.title
            if args.problem: updates["problem_statement"] = args.problem
            if args.solution: updates["solution_overview"] = args.solution
            if args.approach: updates["implementation_approach"] = args.approach
            if args.patterns: updates["implementation_patterns"] = args.patterns
            if args.decisions: updates["implementation_decisions"] = args.decisions
            if args.components: updates["component_details"] = args.components
            update_artifact(args.ticket_id, updates)
        elif args.artifact_action == "finalize":
            gate_result = None
            if args.gate_passed is not None or args.gate_output:
                gate_result = {"passed": args.gate_passed, "output": args.gate_output or ""}
            test_result = None
            if any([args.tests_passed, args.tests_failed, args.tests_skipped, args.test_output]):
                test_result = {
                    "summary": {
                        "passed": args.tests_passed,
                        "failed": args.tests_failed,
                        "skipped": args.tests_skipped,
                        "total": args.tests_passed + args.tests_failed + args.tests_skipped
                    },
                    "output": args.test_output or ""
                }
            finalize_artifact(args.ticket_id, gate_result, test_result)
        elif args.artifact_action == "list":
            list_artifacts(config)
        elif args.artifact_action == "open":
            open_artifact(args.ticket_id)
        else:
            artifact_parser.print_help()
    elif args.subcommand == "detect":
        detect_stack(args.path, config)
    elif args.subcommand == "validate":
        validate_config(config)
    elif args.subcommand == "tech-stacks":
        list_tech_stacks(config)
    elif args.subcommand == "skills":
        list_skills(config)
    elif args.subcommand == "init":
        init_project(args.template, args.alias, args.path, config)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()