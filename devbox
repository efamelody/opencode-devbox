                    "completed": "[DONE]",
                    "failed": "[FAILED]",
                    "cancelled": "[CANCELLED]"
                }.get(status, "[UNKNOWN]")
                
                print(f"{status_icon} {ticket_id}")
                print(f"  Title: {title}")
                print(f"  Target: {target}")
                print(f"  Created: {created}")
                print(f"  Path: {artifact_dir}/index.html")
                print()

