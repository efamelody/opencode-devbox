import re
from datetime import datetime
from pathlib import Path
from typing import Dict, List, Optional, Any

CONFIG_PATH = "devbox-config.yaml"
ARTIFACTS_DIR = ".artifacts"
ARTIFACT_TEMPLATE_DIR = ".devbox/skills/artifact/templates"

def load_config() -> Dict[str, Any]:
    if not os.path.exists(CONFIG_PATH):
        print(f"[ERROR] Config file '{CONFIG_PATH}' not found.")
        sys.exit(1)
    with open(CONFIG_PATH, "r") as f:
        return yaml.safe_load(f)

def save_config(config: Dict[str, Any]) -> None:
    with open(CONFIG_PATH, "w") as f:
        yaml.dump(config, f, default_flow_style=False, sort_keys=False)

def detect_tech_stack(project_path: str, tech_stacks: Dict[str, Any]) -> Optional[str]:
    abs_path = os.path.abspath(project_path)
    if not os.path.exists(abs_path):
        return None
    
    for stack_name, stack_config in tech_stacks.items():
        detection_files = stack_config.get("detection", {}).get("files", [])
        for pattern in detection_files:
            matches = glob.glob(os.path.join(abs_path, pattern))
            if matches:
                return stack_name
    return None

def resolve_project_config(alias: str, config: Dict[str, Any]) -> Dict[str, Any]:
    projects = config.get("projects", {})
    if alias not in projects:
        print(f"[ERROR] Project alias '{alias}' not found in registry.")
        sys.exit(1)
    
    project = projects[alias].copy()
    tech_stacks = config.get("tech_stacks", {})
    
    if "type" not in project:
        detected = detect_tech_stack(project["path"], tech_stacks)
        if detected:
            project["type"] = detected
            print(f"[AUTO-DETECT] Tech stack: {detected}")
        else:
            print(f"[WARN] Could not auto-detect tech stack for {alias}, defaulting to 'node'")
            project["type"] = "node"
    
    if "gate" not in project:
        stack_config = tech_stacks.get(project["type"], {})
        template = stack_config.get("gate_template", "")
        if template:
            project["gate"] = template.format(path=project["path"])
    
    stack_config = tech_stacks.get(project["type"], {})
    default_skills = stack_config.get("default_skills", [])
    project_skills = project.get("skills", [])
    project["skills"] = list(dict.fromkeys(default_skills + project_skills))
    
    return project

def run_gate(alias: str, config: Dict[str, Any]) -> None:
    project = resolve_project_config(alias, config)
    rel_path = project["path"]
    gate_cmd = project.get("gate", "")
    abs_path = os.path.abspath(rel_path)

    print(f"=== [GATE] RUNNING VERIFICATION GATE FOR [{alias}] ===")
    print(f"[PATH] Path: {abs_path}")
    print(f"[TYPE] Type: {project.get('type', 'unknown')}")
    print(f"[CMD] Command: {gate_cmd}\n")

    if not os.path.exists(abs_path):
        print(f"[WARN] Target directory does not exist: {abs_path}")
        print("   Skipping live execution.")
        return

    result = subprocess.run(gate_cmd, shell=True, cwd=os.path.dirname(os.path.abspath(__file__)))
    if result.returncode == 0:
        print(f"\n[PASS] GATE PASSED for [{alias}]")
    else:
        print(f"\n[FAIL] GATE FAILED for [{alias}] (Exit code: {result.returncode})")
    sys.exit(result.returncode)

def create_task(alias: str, prompt: str, config: Dict[str, Any]) -> None:
    project = resolve_project_config(alias, config)

    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    task_id = f"task_{timestamp}"
    inbox_dir = os.path.join(".agent-inbox", alias, task_id)
    os.makedirs(inbox_dir, exist_ok=True)

    with open(os.path.join(inbox_dir, "request.md"), "w") as f:
        f.write(f"# Task Request for [{alias}]\n\n{prompt}\n")

    task_data = {
        "version": "2.1",
        "status": "pending",
        "task_id": task_id,
        "target_alias": alias,
        "target_path": project["path"],
        "target_type": project.get("type"),
        "skills": project.get("skills", []),
        "env": project.get("env", {}),
        "created_at": datetime.now().isoformat()
    }
    with open(os.path.join(inbox_dir, "task.json"), "w") as f:
        yaml.dump(task_data, f)

    # Auto-create artifact for this task
    create_artifact_from_task(alias, task_id, "TASK", prompt, project, config)

    print(f"[OK] Task package [{task_id}] delivered to: {inbox_dir}")

def create_artifact_from_task(alias: str, task_id: str, ticket_type: str, prompt: str, project: Dict[str, Any], config: Dict[str, Any]) -> str:
    """Create an artifact folder from a task"""
    # Generate ticket ID from task
    ticket_id = task_id.replace("task_", "TASK-")
    
    artifact_dir = os.path.join(ARTIFACTS_DIR, ticket_id)
    os.makedirs(artifact_dir, exist_ok=True)
    
    # Create subdirectories
    for subdir in ["changes", "implementation", "verification", "assets"]:
        os.makedirs(os.path.join(artifact_dir, subdir), exist_ok=True)
    
    # Copy styles.css
    styles_src = os.path.join(ARTIFACT_TEMPLATE_DIR, "styles.css")
    styles_dst = os.path.join(artifact_dir, "assets", "styles.css")
    if os.path.exists(styles_src):
        shutil.copy2(styles_src, styles_dst)
    
    # Create metadata.json
    metadata = {
        "ticket_id": ticket_id,
        "ticket_type": ticket_type,
        "title": prompt[:100] + ("..." if len(prompt) > 100 else ""),
        "status": "pending",
        "target_alias": alias,
        "target_type": project.get("type"),
        "target_path": project.get("path"),
        "skills": project.get("skills", []),
        "env": project.get("env", {}),
        "created_at": datetime.now().isoformat(),
        "problem_statement": prompt,
        "solution_overview": "",
        "implementation_approach": "",
        "implementation_patterns": "",
        "implementation_decisions": "",
        "component_details": "",
        "files_changed": [],
        "unified_diff": "",
        "gate_status": "pending",
        "gate_output": "",
        "test_summary": {"passed": 0, "failed": 0, "skipped": 0, "total": 0},
        "test_output": "",
        "checklist": [],
        "spec_url": "",
        "task_url": f"file://{os.path.abspath(os.path.join('.agent-inbox', alias, task_id))}",
        "pr_url": "",
        "commits_url": ""
    }
    
    with open(os.path.join(artifact_dir, "metadata.json"), "w") as f:
        json.dump(metadata, f, indent=2)
    
    # Create placeholder files
    with open(os.path.join(artifact_dir, "changes", "file-diffs.md"), "w") as f:
        f.write(f"# File Diffs for {ticket_id}\n\n_Pending implementation_\n")
    
    with open(os.path.join(artifact_dir, "changes", "file-list.json"), "w") as f:
        json.dump([], f, indent=2)
    
    with open(os.path.join(artifact_dir, "implementation", "approach.md"), "w") as f:
        f.write(f"# Implementation Approach\n\n_TBD_\n")
    
    with open(os.path.join(artifact_dir, "implementation", "patterns.md"), "w") as f:
        f.write(f"# Patterns Used\n\n_TBD_\n")
    
    with open(os.path.join(artifact_dir, "implementation", "decisions.md"), "w") as f:
        f.write(f"# Key Decisions\n\n_TBD_\n")
    
    with open(os.path.join(artifact_dir, "verification", "gate-output.txt"), "w") as f:
        f.write("_Gate not yet run_\n")
    
    with open(os.path.join(artifact_dir, "verification", "test-results.json"), "w") as f:
        json.dump({"passed": 0, "failed": 0, "skipped": 0, "total": 0}, f, indent=2)
    
    # Generate initial HTML
    generate_artifact_html(ticket_id)
    
    print(f"[OK] Artifact [{ticket_id}] created at: {artifact_dir}")
    return artifact_dir

def generate_artifact_html(ticket_id: str) -> None:
    """Generate HTML artifact from metadata and template"""
    artifact_dir = os.path.join(ARTIFACTS_DIR, ticket_id)
    metadata_path = os.path.join(artifact_dir, "metadata.json")
    template_path = os.path.join(ARTIFACT_TEMPLATE_DIR, "artifact.html")
    
    if not os.path.exists(metadata_path):
        print(f"[ERROR] Metadata not found for {ticket_id}")
        return
    
    if not os.path.exists(template_path):
        print(f"[ERROR] Template not found at {template_path}")
        return
    
    with open(metadata_path, "r") as f:
        metadata = json.load(f)
    
    with open(template_path, "r", encoding="utf-8") as f:
        template = f.read()
    
    # Prepare template variables
    file_rows = ""
    for fc in metadata.get("files_changed", []):
        file_type_class = f"type-{fc.get('type', 'modified')}"
        file_rows += f"""
        <tr>
            <td><code>{fc.get('file', '')}</code></td>
            <td><span class="file-type {file_type_class}">{fc.get('type', 'modified')}</span></td>
            <td class="lines-added">+{fc.get('lines_added', 0)}</td>
            <td class="lines-removed">-{fc.get('lines_removed', 0)}</td>
            <td>{fc.get('description', '')}</td>
        </tr>"""
    
    if not file_rows:
        file_rows = '<tr><td colspan="5" style="text-align:center;color:#9ca3af;">No files changed yet</td></tr>'
    
    checklist_items = ""
    for item in metadata.get("checklist", []):
        status_class = "failed" if item.get("status") == "failed" else ""
        checklist_items += f'<li class="{status_class}">{item.get("item", "")}</li>'
    
    if not checklist_items:
        checklist_items = '<li style="color:#9ca3af;">No checklist items</li>'
    
    test_summary = metadata.get("test_summary", {})
    test_summary_html = f"""
        <span class="test-passed">✓ Passed: {test_summary.get('passed', 0)}</span>
        <span class="test-failed">✗ Failed: {test_summary.get('failed', 0)}</span>
        <span class="test-skipped">○ Skipped: {test_summary.get('skipped', 0)}</span>
    """
    
    # Replace template variables
    replacements = {
        "{{TICKET_ID}}": metadata.get("ticket_id", ""),
        "{{TICKET_TYPE}}": metadata.get("ticket_type", "TASK"),
        "{{TITLE}}": metadata.get("title", ""),
        "{{STATUS}}": metadata.get("status", "pending"),
        "{{TARGET_ALIAS}}": metadata.get("target_alias", ""),
        "{{TARGET_TYPE}}": metadata.get("target_type", ""),
        "{{CREATED_AT}}": format_datetime(metadata.get("created_at", "")),
        "{{COMPLETED_AT}}": format_datetime(metadata.get("completed_at", "")) or "—",
        "{{PROBLEM_STATEMENT}}": escape_html(metadata.get("problem_statement", "")),
        "{{SOLUTION_OVERVIEW}}": escape_html(metadata.get("solution_overview", "")),
        "{{FILES_CHANGED_COUNT}}": str(len(metadata.get("files_changed", []))),
        "{{FILE_ROWS}}": file_rows,
        "{{HAS_CHANGES_DETAIL}}": "true" if metadata.get("unified_diff") else "false",
        "{{UNIFIED_DIFF}}": escape_html(metadata.get("unified_diff", "")),
        "{{IMPLEMENTATION_APPROACH}}": escape_html(metadata.get("implementation_approach", "")),
        "{{IMPLEMENTATION_PATTERNS}}": escape_html(metadata.get("implementation_patterns", "")),
        "{{IMPLEMENTATION_DECISIONS}}": escape_html(metadata.get("implementation_decisions", "")),
        "{{COMPONENT_DETAILS}}": escape_html(metadata.get("component_details", "")),
        "{{GATE_STATUS}}": metadata.get("gate_status", "pending"),
        "{{GATE_OUTPUT}}": escape_html(metadata.get("gate_output", "")),
        "{{TEST_SUMMARY}}": test_summary_html,
        "{{TEST_OUTPUT}}": escape_html(metadata.get("test_output", "")),
        "{{CHECKLIST_ITEMS}}": checklist_items,
        "{{SPEC_URL}}": metadata.get("spec_url", ""),
        "{{TASK_URL}}": metadata.get("task_url", ""),
        "{{PR_URL}}": metadata.get("pr_url", ""),
        "{{COMMITS_URL}}": metadata.get("commits_url", ""),
        "{{GENERATED_AT}}": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    }
    
    html = template
    for key, value in replacements.items():
        html = html.replace(key, value)
    
    # Handle conditional blocks (simple approach)
    html = re.sub(r'{% if HAS_CHANGES_DETAIL %}(.*?){% endif %}', 
                  r'\1' if metadata.get("unified_diff") else '', 
                  html, flags=re.DOTALL)
    html = re.sub(r'{% if SPEC_URL %}(.*?){% endif %}', 
                  r'\1' if metadata.get("spec_url") else '', 
                  html, flags=re.DOTALL)
    html = re.sub(r'{% if TASK_URL %}(.*?){% endif %}', 
                  r'\1' if metadata.get("task_url") else '', 
                  html, flags=re.DOTALL)
    html = re.sub(r'{% if PR_URL %}(.*?){% endif %}', 
                  r'\1' if metadata.get("pr_url") else '', 
                  html, flags=re.DOTALL)
    html = re.sub(r'{% if COMMITS_URL %}(.*?){% endif %}', 
                  r'\1' if metadata.get("commits_url") else '', 
                  html, flags=re.DOTALL)
    
    output_path = os.path.join(artifact_dir, "index.html")
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(html)
    
    print(f"[OK] Generated {output_path}")

def format_datetime(iso_str: str) -> str:
    if not iso_str:
        return ""
    try:
        dt = datetime.fromisoformat(iso_str.replace('Z', '+00:00'))
        return dt.strftime("%Y-%m-%d %H:%M:%S")
    except:
        return iso_str

def escape_html(text: str) -> str:
    if not text:
        return ""
    return (text
        .replace("&", "&")
        .replace("<", "<")
        .replace(">", ">")
        .replace("\"", "\"")
        .replace("\'", "\'")
        .replace("\n", "<br>")
    )

def create_artifact(alias: str, ticket_id: str, ticket_type: str, title: str, prompt: str, config: Dict[str, Any]) -> None:
    """Manual artifact creation"""
    project = resolve_project_config(alias, config)
    artifact_dir = create_artifact_from_task(alias, ticket_id, ticket_type, prompt, project, config)
    
    # Update metadata with provided title
    metadata_path = os.path.join(artifact_dir, "metadata.json")
    with open(metadata_path, "r") as f:
        metadata = json.load(f)
    metadata["title"] = title
    metadata["ticket_id"] = ticket_id
    metadata["ticket_type"] = ticket_type
    with open(metadata_path, "w") as f:
        json.dump(metadata, f, indent=2)
    
    generate_artifact_html(ticket_id)

def update_artifact(ticket_id: str, updates: Dict[str, Any]) -> None:
    """Update artifact metadata and regenerate HTML"""
    artifact_dir = os.path.join(ARTIFACTS_DIR, ticket_id)
    metadata_path = os.path.join(artifact_dir, "metadata.json")
    
    if not os.path.exists(metadata_path):
        print(f"[ERROR] Artifact {ticket_id} not found")
        return
    
    with open(metadata_path, "r") as f:
        metadata = json.load(f)
    
    metadata.update(updates)
    
    with open(metadata_path, "w") as f:
        json.dump(metadata, f, indent=2)
    
    generate_artifact_html(ticket_id)
    print(f"[OK] Updated artifact {ticket_id}")

def finalize_artifact(ticket_id: str, gate_result: Dict[str, Any] = None, test_result: Dict[str, Any] = None) -> None:
    """Mark artifact as completed with gate/test results"""
    updates = {
        "status": "completed",
        "completed_at": datetime.now().isoformat(),
    }
    
    if gate_result:
        updates["gate_status"] = "passed" if gate_result.get("passed", False) else "failed"
        updates["gate_output"] = gate_result.get("output", "")
    
    if test_result:
        updates["test_summary"] = test_result.get("summary", {"passed": 0, "failed": 0, "skipped": 0, "total": 0})
        updates["test_output"] = test_result.get("output", "")
    
    update_artifact(ticket_id, updates)

