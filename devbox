def detect_stack(path: str, config: Dict[str, Any]) -> None:
    tech_stacks = config.get("tech_stacks", {})
    abs_path = os.path.abspath(path)
    
    print(f"[DETECT] Detecting tech stack for: {abs_path}")
    if not os.path.exists(abs_path):
        print(f"[ERROR] Path does not exist: {abs_path}")
        sys.exit(1)
    
    detected = detect_tech_stack(path, tech_stacks)
    if detected:
        stack_info = tech_stacks[detected]
        print(f"[OK] Detected: {detected}")
        print(f"   Description: {stack_info.get('description')}")
        print(f"   Default skills: {', '.join(stack_info.get('default_skills', []))}")
        print(f"   Gate template: {stack_info.get('gate_template')}")
    else:
        print("[ERROR] No known tech stack detected")
        print("   Supported stacks:")
        for name, info in tech_stacks.items():
            files = info.get("detection", {}).get("files", [])
            print(f"   • {name}: looks for {', '.join(files)}")

def validate_config(config: Dict[str, Any]) -> None:
    print("[VALIDATE] Validating devbox-config.yaml...\n")
    errors = []
    warnings = []
    
    tech_stacks = config.get("tech_stacks", {})
    projects = config.get("projects", {})
    
    if not tech_stacks:
        errors.append("No tech_stacks defined")
    
    if not projects:
        warnings.append("No projects registered")
    
    for alias, project in projects.items():
        path = project.get("path", "")
        abs_path = os.path.abspath(path)
        
        if not os.path.exists(abs_path):
            warnings.append(f"Project '{alias}': path does not exist: {abs_path}")
        
        project_type = project.get("type")
        if project_type and project_type not in tech_stacks:
            errors.append(f"Project '{alias}': unknown type '{project_type}' (not in tech_stacks)")
        
        gate = project.get("gate")
        if not gate and project_type:
            template = tech_stacks.get(project_type, {}).get("gate_template")
            if not template:
                warnings.append(f"Project '{alias}': no gate command and no template for type '{project_type}'")
    
    for stack_name, stack_config in tech_stacks.items():
        if "detection" not in stack_config:
            warnings.append(f"Tech stack '{stack_name}': missing detection config")
        if "gate_template" not in stack_config:
            warnings.append(f"Tech stack '{stack_name}': missing gate_template")
    
    if errors:
        print("[ERROR] Errors:")
        for e in errors:
            print(f"  • {e}")
    else:
        print("[OK] No errors")
    
    if warnings:
        print("\n[WARN] Warnings:")
        for w in warnings:
            print(f"  • {w}")
    else:
        print("\n[OK] No warnings")
    
    if errors:
        sys.exit(1)

